---
interface Props { id: string; title: string; n?: string }
const { id, title, n } = Astro.props;
---
<section class="d-section" id={id} data-title={title}>
  <header class="d-section__head">
    {n && <span class="d-section__n" aria-hidden="true">{n}</span>}
    <h2 class="d-section__title"><a class="d-anchor" href={`#${id}`}>{title}</a></h2>
  </header>
  <slot />
</section>
