---
import SearchPalette from './SearchPalette';
import { flatNav, url } from '../../lib/nav';
interface Props { path: string }
const { path } = Astro.props;
const section = (p: string) => path.startsWith(p);
const links = [
  { title: 'Foundations', href: '/foundations/color', match: '/foundations' },
  { title: 'Components', href: '/components/button', match: '/components' },
  { title: 'Patterns', href: '/patterns/hold-to-confirm', match: '/patterns' },
  { title: 'Tokens', href: '/resources/tokens', match: '/resources/tokens' },
  { title: 'Figma', href: '/resources/figma', match: '/resources/figma' },
];
---
<header class="d-top">
  <button class="d-menu" type="button" aria-label="Open navigation" aria-expanded="false" data-menu-toggle>
    <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M1 4h12M1 10h12" stroke="currentColor" stroke-width="1.2"/></svg>
  </button>
  <a class="d-mark" href={url('/')} aria-label="Aurora Design System, home">
    <span class="d-mark__word">Aurora</span>
    <span class="d-mark__sep" aria-hidden="true"></span>
    <span class="d-mark__sub">Design System</span>
  </a>
  <div class="d-top__grow"></div>
  <nav class="d-top__links" aria-label="Sections">
    {links.map((l) => <a class="d-top__link" href={url(l.href)} aria-current={section(l.match) ? 'page' : undefined}>{l.title}</a>)}
  </nav>
  <SearchPalette client:idle pages={flatNav.map(({ title, href, summary, group }) => ({ title, href: url(href), summary, group }))} />
  <span class="d-version">v0.1</span>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  btn?.addEventListener('click', () => {
    const open = document.body.dataset.menu !== 'open';
    document.body.dataset.menu = open ? 'open' : '';
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
