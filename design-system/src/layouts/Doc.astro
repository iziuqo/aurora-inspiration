---
import Base from './Base.astro';
import TopBar from '../components/docs/TopBar.astro';
import Sidebar from '../components/docs/Sidebar.astro';
import Toc from '../components/docs/Toc.astro';
import Pager from '../components/docs/Pager.astro';
import PageHeader from '../components/docs/PageHeader.astro';

interface Props {
  title: string;
  lead?: string;
  eyebrow?: string;
  description?: string;
  toc?: boolean;
  /** Meta row under the lead: status, Figma, source, and so on. */
  meta?: { label: string; value: string; href?: string; dot?: 'stable' | 'beta' }[];
  header?: boolean;
}
const { title, lead, eyebrow, description, toc = true, meta, header = true } = Astro.props;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<Base title={title} description={description ?? lead}>
  <TopBar path={path} />
  <div class="d-shell" data-toc={toc ? 'true' : 'false'}>
    <Sidebar path={path} />
    <main class="d-main" id="main">
      <article class="d-content">
        {header && <PageHeader title={title} lead={lead} eyebrow={eyebrow} meta={meta} />}
        <slot />
        <Pager path={path} />
      </article>
    </main>
    {toc && <Toc />}
  </div>
</Base>
