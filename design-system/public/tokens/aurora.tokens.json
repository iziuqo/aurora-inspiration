  "easing": {
    "glide": {
      "$type": "cubicBezier",
      "$value": [
        0.32,
        0.72,
        0,
        1
      ],
      "$description": "Decelerates into place. Anything that moves or changes size."
    },
    "soft": {
      "$type": "cubicBezier",
      "$value": [
        0.4,
        0,
        0.2,
        1
      ],
      "$description": "Symmetric and quiet. Colour, opacity, borders."
    },
    "out": {
      "$type": "cubicBezier",
      "$value": [
        0.25,
        1,
        0.5,
        1
      ],
      "$description": "A long, gentle arrival. Entrances and reveals."
    },
    "linear": {
      "$type": "cubicBezier",
      "$value": [
        0,
        0,
        1,
        1
      ],
      "$description": "Time itself. Only for progress that tracks a held gesture."
    }
  },
  "duration": {
    "instant": {
      "$type": "duration",
